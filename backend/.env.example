# ═══════════════════════════════════════════════════════════════════
# AI-Assisted Interview Platform - Environment Configuration
# ═══════════════════════════════════════════════════════════════════

# ─── LLM API Keys ───────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=4096

GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_TEMPERATURE=0.3

# ─── Database Configuration ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_db
CHECKPOINT_DB_URL=postgresql://postgres:postgres@localhost:5432/interview_db
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5

# ─── Security ───────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production

# ─── CORS Origins ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ─── Interview Configuration ────────────────────────────────────────
RESUME_SHORTLIST_THRESHOLD=0.65
MAX_QUESTIONS_PER_TOPIC=5
READING_TIME_SECONDS=20
ANSWER_TIME_SECONDS=45

# ─── AWS Configuration ──────────────────────────────────────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=interview-audio-uploads-09

# ─── AWS Transcribe Settings ────────────────────────────────────────
# IMPORTANT: Sample rate must match your frontend audio capture settings
# Common values: 16000 (standard), 48000 (high quality), 8000 (telephony)
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_SAMPLE_RATE=48000

# ─── AWS Cognito ────────────────────────────────────────────────────
COGNITO_USER_POOL_ID=ap-south-1_TglqMHRkg
COGNITO_APP_CLIENT_ID=42vcngleoh9pg5h9jipgcnsnfj

# ─── Email Configuration (SMTP/Gmail) ──────────────────────────────
# Use RELAY_* for Gmail or other SMTP relays
RELAY_HOST=smtp.gmail.com
RELAY_PORT=587
RELAY_USERNAME=nivassapkal123@gmail.com
RELAY_PASSWORD=your_relay_password
EMAILS_FROM_EMAIL=nivassapkal123@gmail.com

# ─── ChromaDB Vector Store ──────────────────────────────────────────
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_PORT=8001
USE_CHROMA_SERVER=true

# ─── Debug Mode ─────────────────────────────────────────────────────
DEBUG=true

# ─── Session Settings ───────────────────────────────────────────────
SESSION_EXPIRY_HOURS=72
SESSION_ID_LENGTH=32
